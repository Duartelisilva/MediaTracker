<UserControl x:Class="MediaTracker.Views.WishlistTabView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
             xmlns:converters="clr-namespace:MediaTracker.Converters"
             xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
             mc:Ignorable="d"
             d:DesignHeight="500" d:DesignWidth="700"
             Background="{DynamicResource BackgroundBrush}">

    <UserControl.Resources>
        <converters:BoolToVisibilityConverter x:Key="BoolToVisibilityConverter"/>
        <converters:NullableIntConverter x:Key="NullableIntConverter"/>
        <converters:BooksDateTupleConverter x:Key="BooksDateTupleConverter"/>
        <converters:IntToVisibilityConverter x:Key="IntToVisibilityConverter"/>
        <converters:NullOrEmptyToSeparatorConverter x:Key="NullOrEmptyToSeparatorConverter"/>
        <converters:CollapseArrowConverter x:Key="CollapseArrowConverter"/>
        <converters:ExpandWhileNotEditingConverter x:Key="ExpandWhileNotEditingConverter"/>
        <converters:BoolToTextConverter x:Key="BoolToTextConverter"/>
        <converters:LightBackgroundToForegroundConverter x:Key="LightBackgroundToForegroundConverter"/>
        <converters:WidthDividerConverter x:Key="WidthDividerConverter"/>
		<converters:TypeToVisibilityConverter x:Key="TypeToVisibilityConverter"/>
		
        <!-- Shadow effect for modern cards -->
        <DropShadowEffect x:Key="CardShadow" Color="#333" Opacity="0.1" BlurRadius="12"/>

        <!-- Shadow effect for Edit/Delete/Undo/Save buttons -->
        <DropShadowEffect x:Key="IconShadow" Color="Black" BlurRadius="4" ShadowDepth="0" Opacity="0.45"/>
    </UserControl.Resources>



    <Grid Margin="16">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- ADD Wishlist CARD -->
        <Border Grid.Row="0" Padding="16" Margin="0,0,0,24" CornerRadius="12" Background="{DynamicResource CardBrush}"
                BorderBrush="{DynamicResource TabBorderBrush}" Effect="{StaticResource CardShadow}">
            <ScrollViewer HorizontalScrollBarVisibility="Auto" VerticalScrollBarVisibility="Disabled">
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <!-- Title -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Title:" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                        <xctk:WatermarkTextBox Width="180" Height="36" Padding="4" Text="{Binding NewTitle}" VerticalContentAlignment="Center" Watermark="Title"/>
                    </StackPanel>
                    <!-- Year -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Text="Year:" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
                        <xctk:WatermarkTextBox Width="60" Height="36" Padding="4" Text="{Binding NewYear}" VerticalContentAlignment="Center" Watermark="Year"/>
                    </StackPanel>
					
					<!-- Category Type -->
					<StackPanel Margin="0,0,12,0">
						<TextBlock Text="Type:" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
						<ComboBox Width="60" Height="36" VerticalAlignment="Center" VerticalContentAlignment="Center" ItemsSource="{Binding WishlistTypes}" SelectedItem="{Binding SelectedType}"/>
					</StackPanel>

					<!-- Movies -->
					<StackPanel Margin="0,0,12,0" 
                            Visibility="{Binding SelectedType, Converter={StaticResource TypeToVisibilityConverter}, ConverterParameter=Movie}">
						<TextBlock Text="Franchise:" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
						<xctk:WatermarkTextBox Width="120" Height="36" Text="{Binding NewFranchise}" Watermark="Franchise" VerticalContentAlignment="Center"/>
					</StackPanel>
					<!-- Series -->
					<StackPanel Margin="0,0,12,0" 
                            Visibility="{Binding SelectedType, Converter={StaticResource TypeToVisibilityConverter}, ConverterParameter=Series}">
						<TextBlock Text="Author:" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
						<xctk:WatermarkTextBox Width="60" Height="36" Text="{Binding NewSeasonNumber}" Watermark="Season" VerticalContentAlignment="Center"/>
					</StackPanel>
					<!-- Book -->
					<StackPanel Margin="0,0,12,0" 
							Visibility="{Binding SelectedType, Converter={StaticResource TypeToVisibilityConverter}, ConverterParameter=Books}">
						<TextBlock Text="Author:" FontSize="12" Foreground="{DynamicResource TextBrush}"/>
						<xctk:WatermarkTextBox Width="120" Height="36" Text="{Binding NewAuthor}" Watermark="Author" VerticalContentAlignment="Center"/>					
					</StackPanel>
					<!-- Add Button -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Height="16"/>
                        <Button Content="Add" Height="36" Padding="20,6" Background="#4CAF50" Foreground="White" Command="{Binding AddMediaCommand}"/>
                    </StackPanel>
                    <!-- Comments Button -->
                    <StackPanel Margin="0,0,12,0">
                        <TextBlock Height="16"/>
                        <ToggleButton Content="Comments"
                                      Height="36"
                                      Padding="20,6"
                                      Background="#607D8B"
                                      Foreground="White"
                                      IsChecked="{Binding ShowComments, Mode=TwoWay}"
                                      Checked="CommentsToggle_Click"
                                      Unchecked="CommentsToggle_Click"/>
                    </StackPanel>
                </StackPanel>
            </ScrollViewer>
        </Border>



        <!-- WISHLIST LIST -->
        <ScrollViewer x:Name="MainScrollViewer" Grid.Row="1" Background="{DynamicResource BackgroundBrush}">
            <ItemsControl x:Name="MainItemsControl" ItemsSource="{Binding SagaGroups}">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <StackPanel Margin="0,0,0,24">
                            <!-- Type Header -->
                            <StackPanel Orientation="Horizontal" Cursor="Hand"
                                MouseLeftButtonUp="SagaHeader_Click">
                                <TextBlock Text="{Binding Name}" FontWeight="Bold" FontSize="24"/>
                                <TextBlock Text="{Binding IsCollapsed, Converter={StaticResource CollapseArrowConverter}}" 
                                   Margin="4,8,0,0"/>
                            </StackPanel>

                            <!-- Wishlist under this Type -->
                            <ItemsControl ItemsSource="{Binding Items}" 
                                    Visibility="{Binding IsCollapsed, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}">
                                <ItemsControl.ItemsPanel>
                                    <ItemsPanelTemplate>
                                        <WrapPanel />
                                    </ItemsPanelTemplate>
                                </ItemsControl.ItemsPanel>

                                <ItemsControl.ItemContainerStyle>
                                    <Style TargetType="ContentPresenter">
                                        <Setter Property="FrameworkElement.Width"
                                                Value="{Binding RelativeSource={RelativeSource AncestorType=ScrollContentPresenter}, 
                                                        Path=ActualWidth, 
                                                        Converter={StaticResource WidthDividerConverter}, 
                                                        ConverterParameter=4}"/>
                                        <Setter Property="FrameworkElement.Margin" Value="8"/>
                                        <Setter Property="FrameworkElement.MinWidth" Value="200"/>
                                        <Setter Property="FrameworkElement.MaxWidth" Value="340"/>
                                    </Style>
                                </ItemsControl.ItemContainerStyle>

                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Grid>
                                            <!-- BEGIN: Wishlist Card -->
                                            <Border 
                                                    Margin="0,0,16,16"
                                                    VerticalAlignment="Top"
                                                    Padding="12"
                                                    CornerRadius="12"
                                                    BorderBrush="{DynamicResource TabBorderBrush}" 
                                                    BorderThickness="1.5"
                                                    Background="{Binding BrushForDarkMode}"   
                                                    Effect="{StaticResource CardShadow}"
                                                    MouseLeftButtonUp="MediaCard_Click">
                                                <StackPanel>
                                                    <!-- HEADER -->
                                                    <Grid>
                                                        <Grid.ColumnDefinitions>
                                                            <ColumnDefinition/>
                                                            <ColumnDefinition Width="Auto"/>
                                                        </Grid.ColumnDefinitions>

                                                        <StackPanel>
                                                            <!-- DISPLAY MODE -->
                                                            <StackPanel Orientation="Vertical" Margin="0,1,0,0"
                                                                        Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}">

                                                                <!-- Semi-transparent background for all text -->
                                                                <Border Background="#40FFFFFF" CornerRadius="4" Padding="6" MaxWidth="300">
                                                                    <StackPanel>
                                                                        <!-- Title -->
                                                                        <TextBlock Text="{Binding Title}"
                                                                                   FontSize="16"
                                                                                   FontWeight="SemiBold"
                                                                                   Foreground="{Binding Brush, Converter={StaticResource LightBackgroundToForegroundConverter}}"
                                                                                   TextWrapping="Wrap"
                                                                                   HorizontalAlignment="Center"/>
                                                                        <!-- Info line -->
                                                                        <TextBlock Text="{Binding DisplayMeta}"
                                                                                   FontSize="12"
                                                                                   Foreground="{Binding Brush, Converter={StaticResource LightBackgroundToForegroundConverter}}"
                                                                                   TextWrapping="Wrap"
                                                                                   HorizontalAlignment="Center"/>
                                                                    </StackPanel>
                                                                </Border>
                                                            </StackPanel>

                                                            <!-- EDIT MODE -->
                                                            <StackPanel Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}">
                                                                <!-- Title -->
                                                                <xctk:WatermarkTextBox Text="{Binding Title}"
                                                                 Watermark="Title"
                                                                 FontSize="15"
                                                                 Padding="4"
                                                                 Margin="0,0,0,6"
                                                                 MaxWidth="300"/>

                                                                <!-- Year / Type / Conditional Field-->
                                                                <Grid>
                                                                    <Grid.ColumnDefinitions>
                                                                        <ColumnDefinition Width="60"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                        <ColumnDefinition Width="*"/>
                                                                    </Grid.ColumnDefinitions>

																	<!-- Year -->
																	<xctk:WatermarkTextBox Grid.Column="0" Text="{Binding Year}" Watermark="Year" VerticalContentAlignment="Center" Margin="0,0,6,0"/>

																	<!-- Type -->
																	<ComboBox Grid.Column="1"
																			  Height="36"
																			  ItemsSource="{Binding DataContext.WishlistTypes, RelativeSource={RelativeSource AncestorType=UserControl}}"
																			  SelectedItem="{Binding Type, Mode=TwoWay}"
																			  VerticalContentAlignment="Center"
																			  Margin="0,0,6,0"/>

																	<!-- Conditional fields -->
																	<StackPanel Grid.Column="2" Orientation="Horizontal">
																		<xctk:WatermarkTextBox Text="{Binding Author}" Watermark="Author" Width="200" VerticalContentAlignment="Center" 
																							   Visibility="{Binding Type, Converter={StaticResource TypeToVisibilityConverter}, ConverterParameter=Books}"/>
																		<xctk:WatermarkTextBox Text="{Binding Franchise}" Watermark="Franchise" Width="200" VerticalContentAlignment="Center" 
																							   Visibility="{Binding Type, Converter={StaticResource TypeToVisibilityConverter}, ConverterParameter=Movie}"/>
																		<xctk:WatermarkTextBox Text="{Binding SeasonNumber}" Watermark="Season" Width="200" VerticalContentAlignment="Center" 
																							   Visibility="{Binding Type, Converter={StaticResource TypeToVisibilityConverter}, ConverterParameter=Series}"/>
																	</StackPanel>
                                                                </Grid>
                                                                <xctk:ColorPicker
                                                                        SelectedColor="{Binding BaseColor, Mode=TwoWay}"
                                                                        Margin="0,6,0,6"
                                                                        Width="120"/>
                                                            </StackPanel>
                                                        </StackPanel>
                                                    </Grid>

                                                    <!-- COMMENTS -->
                                                    <Border Margin="0,10,0,0"
                                                            Padding="10"
                                                            Background="#DCDCDC"
                                                            CornerRadius="8"
                                                            Height="80"
                                                            Visibility="{Binding DataContext.ShowComments,
                                                                         RelativeSource={RelativeSource AncestorType=UserControl},
                                                                         Converter={StaticResource BoolToVisibilityConverter}}">
                                                        <ScrollViewer VerticalScrollBarVisibility="Auto">
                                                            <Grid>
                                                                <TextBlock Text="{Binding Note}"
                                                                           TextWrapping="Wrap"
                                                                           Foreground="#333"
                                                                           Visibility="{Binding IsEditing,
                                                                               Converter={StaticResource BoolToVisibilityConverter},
                                                                               ConverterParameter=False}"/>

                                                                <TextBox Text="{Binding Note}"
                                                                         AcceptsReturn="True"
                                                                         TextWrapping="Wrap"
                                                                         VerticalScrollBarVisibility="Auto"
                                                                         Visibility="{Binding IsEditing,
                                                                             Converter={StaticResource BoolToVisibilityConverter},
                                                                             ConverterParameter=True}"
                                                                         Padding="6"/>
                                                            </Grid>
                                                        </ScrollViewer>
                                                    </Border>
                                                </StackPanel>
                                            </Border>
                                            <!-- END: Book Card -->
                                            <!-- ACTION BUTTONS -->
                                            <StackPanel Orientation="Horizontal"
                                                        HorizontalAlignment="Right"
                                                        VerticalAlignment="Top"
                                                        Margin="0,-14,4,0"
                                                        Visibility="{Binding IsSidePanelOpen, Converter={StaticResource BoolToVisibilityConverter}}">
                                                <Border Background="{Binding Brush}" 
                                                        BorderBrush="Black"
                                                        BorderThickness="1"
                                                        CornerRadius="6"
                                                        Padding="4"
                                                        Effect="{StaticResource IconShadow}">
                                                    <StackPanel Orientation="Horizontal">
                                                        <Button Width="28" Height="28"
                                                                FontFamily="Segoe MDL2 Assets"
                                                                FontSize="14"
                                                                ToolTip="Favorite"
                                                                Background="#FFD700"
                                                                Foreground="Black"
                                                                BorderBrush="Black"
                                                                BorderThickness="1.5"
                                                                Margin="0,0,4,0"
                                                                Effect="{StaticResource IconShadow}"
                                                                Command="{Binding DataContext.ToggleFavoriteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}">
                                                            <TextBlock Text="&#xE735;" FontWeight="Bold" FontSize="14" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                                                        </Button>
                                                        <Button Width="28" Height="28" FontFamily="Segoe MDL2 Assets" FontSize="14" Content="" ToolTip="Edit"
                                                                Command="{Binding DataContext.EditItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}"
                                                                Background="#2196F3" Foreground="White" BorderBrush="Black" BorderThickness="1.5" Margin="0,0,4,0"
                                                                Effect="{StaticResource IconShadow}"/>
                                                        <Button Width="28" Height="28" FontFamily="Segoe MDL2 Assets" FontSize="14" Content="" ToolTip="Delete"
                                                                Command="{Binding DataContext.RemoveMediaCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}, ConverterParameter=False}"
                                                                Background="#F44336" Foreground="White" BorderBrush="Black" BorderThickness="1.5" Margin="0,0,0,0"
                                                                Effect="{StaticResource IconShadow}"/>
                                                        <Button Width="28" Height="28" FontFamily="Segoe MDL2 Assets" FontSize="14" Content="" ToolTip="Save"
                                                                Command="{Binding DataContext.SaveItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Background="#4CAF50" Foreground="White" BorderBrush="Black" BorderThickness="1.5" Margin="0,0,4,0"
                                                                Effect="{StaticResource IconShadow}"/>
                                                        <Button Width="28" Height="28" FontFamily="Segoe MDL2 Assets" FontSize="14" Content="" ToolTip="Undo"
                                                                Command="{Binding DataContext.UndoItemCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                                                CommandParameter="{Binding}"
                                                                Visibility="{Binding IsEditing, Converter={StaticResource BoolToVisibilityConverter}}"
                                                                Background="#FFC107" Foreground="White" BorderBrush="Black" BorderThickness="1.5" Margin="0,0,0,0"
                                                                Effect="{StaticResource IconShadow}"/>
                                                    </StackPanel>
                                                </Border>
                                            </StackPanel>
                                            <Grid HorizontalAlignment="Left" VerticalAlignment="Top" Margin="5,0,0,0" IsHitTestVisible="False">
                                                <Grid.Style>
                                                    <Style TargetType="Grid">
                                                        <Setter Property="Visibility" Value="Collapsed"/>
                                                        <Style.Triggers>
                                                            <MultiDataTrigger>
                                                                <MultiDataTrigger.Conditions>
                                                                    <Condition Binding="{Binding IsFavorite}" Value="True"/>
                                                                    <Condition Binding="{Binding IsEditing}" Value="False"/>
                                                                </MultiDataTrigger.Conditions>
                                                                <Setter Property="Visibility" Value="Visible"/>
                                                            </MultiDataTrigger>
                                                        </Style.Triggers>
                                                    </Style>
                                                </Grid.Style>

                                                <!-- Black outline -->
                                                <TextBlock Text="★" FontSize="24" Foreground="Black" Margin="-2.3,-5,0,0"/>
                                                <TextBlock Text="★" FontSize="18" Foreground="Gold"/>
                                            </Grid>
                                        </Grid>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>
                        </StackPanel>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>
    </Grid>
</UserControl>