<Window x:Class="MediaTracker.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:views="clr-namespace:MediaTracker.Views"
        xmlns:vm="clr-namespace:MediaTracker.ViewModels"
        xmlns:converters="clr-namespace:MediaTracker.Converters" xmlns:xctk="http://schemas.xceed.com/wpf/xaml/toolkit"
        Title="Media Tracker" Height="500" Width="800"
        Background="{DynamicResource BackgroundBrush}"
        Foreground="{DynamicResource TextBrush}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <converters:BoolToSunMoonConverter x:Key="BoolToSunMoonConverter"/>
    </Window.Resources>

    <DockPanel LastChildFill="True">
        <!-- Top bar -->
        <Grid DockPanel.Dock="Top"
              Margin="8"
              Background="{DynamicResource BackgroundBrush}">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="Auto"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>
            <Button Command="{Binding ToggleDarkModeCommand}"
                Grid.Column="0"
                Content="{Binding IsDarkMode, Converter={StaticResource BoolToSunMoonConverter}}"
                FontSize="18"
                Padding="6"
                ToolTip="Toggle dark/light mode">
                <Button.Template>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="Bd"
                            Background="{DynamicResource CardBrush}"
                            BorderBrush="{DynamicResource DarkModeButtonBorderBrush}"
                            BorderThickness="1"
                            CornerRadius="4"
                            SnapsToDevicePixels="True">
                            <ContentPresenter x:Name="cp"
                                  HorizontalAlignment="Center"
                                  VerticalAlignment="Center"
                                  ContentSource="Content"
                                  Margin="{TemplateBinding Padding}"/>
                        </Border>

                        <ControlTemplate.Triggers>
                            <!-- Hover -->
                            <Trigger Property="IsMouseOver" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabHoverBrush}"/>
                            </Trigger>

                            <!-- Pressed -->
                            <Trigger Property="IsPressed" Value="True">
                                <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                                <Setter TargetName="Bd" Property="BorderBrush" Value="{DynamicResource TabSelectedBrush}"/>
                            </Trigger>

                            <!-- Dark mode text color -->
                            <DataTrigger Binding="{Binding IsDarkMode}" Value="True">
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="White"/>
                            </DataTrigger>

                            <!-- Light mode text color -->
                            <DataTrigger Binding="{Binding IsDarkMode}" Value="False">
                                <Setter TargetName="cp" Property="TextElement.Foreground" Value="Black"/>
                            </DataTrigger>
                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Button.Template>
            </Button>
            
            <StackPanel Grid.Column="1"
                        Margin="6,0,0,0"
                        Orientation="Horizontal"
                        HorizontalAlignment="Left"
                        VerticalAlignment="Center">
                
                <!-- Dropdown -->
                <ComboBox Width="80"
                  Margin="0,0,6,0"
                  SelectedItem="{Binding SelectedSearchOption}"
                  VerticalContentAlignment="Center">

                    <ComboBox.ItemsSource>
                        <x:Array Type="{x:Type vm:SearchOption}">
                            <vm:SearchOption>Title</vm:SearchOption>
                            <vm:SearchOption>Year</vm:SearchOption>
                            <vm:SearchOption>Saga</vm:SearchOption>
                            <vm:SearchOption>Franchise</vm:SearchOption>
                            <vm:SearchOption>Author</vm:SearchOption>
                            <vm:SearchOption>Favorite</vm:SearchOption>
                        </x:Array>
                    </ComboBox.ItemsSource>

                    <ComboBox.ItemContainerStyle>
                        <Style TargetType="ComboBoxItem">
                            <Setter Property="Visibility" Value="Visible"/>
                            <Style.Triggers>

                                <!-- Hide Author if NOT Books -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding}" 
                                   Value="{x:Static vm:SearchOption.Author}"/>
                                        <Condition Binding="{Binding DataContext.IsBooksTab, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>

                                <!-- Hide Franchise if NOT Movies -->
                                <MultiDataTrigger>
                                    <MultiDataTrigger.Conditions>
                                        <Condition Binding="{Binding}" 
                                   Value="{x:Static vm:SearchOption.Franchise}"/>
                                        <Condition Binding="{Binding DataContext.IsMoviesTab, RelativeSource={RelativeSource AncestorType=Window}}"
                                   Value="False"/>
                                    </MultiDataTrigger.Conditions>
                                    <Setter Property="Visibility" Value="Collapsed"/>
                                </MultiDataTrigger>

                            </Style.Triggers>
                        </Style>
                    </ComboBox.ItemContainerStyle>

                </ComboBox>


                <!-- Search box -->
                <xctk:WatermarkTextBox
                    Width="155"
                    Height="32"
                    Padding="6"
                    Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                    Watermark="Search">

                    <xctk:WatermarkTextBox.Style>
                        <Style TargetType="xctk:WatermarkTextBox">
                            <Style.Triggers>
                                <!-- Disable when Favorite selected -->
                                <DataTrigger Binding="{Binding SelectedSearchOption}"
                                 Value="{x:Static vm:SearchOption.Favorite}">
                                    <Setter Property="IsEnabled" Value="False"/>
                                    <Setter Property="Text" Value=""/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </xctk:WatermarkTextBox.Style>

                </xctk:WatermarkTextBox>

            </StackPanel>

        </Grid>

        <!-- Main content -->
        <TabControl ItemsSource="{Binding Tabs}"
                    SelectedItem="{Binding SelectedTab}"
                    Background="{DynamicResource BackgroundBrush}"
                    Foreground="{DynamicResource TextBrush}">

            <TabControl.ItemContainerStyle>
                <Style TargetType="TabItem">
                    <Setter Property="Background" Value="{DynamicResource CardBrush}"/>
                    <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                    <Setter Property="Padding" Value="16,12"/>
                    <Setter Property="Template">
                        <Setter.Value>
                            <ControlTemplate TargetType="TabItem">
                                <Border x:Name="Bd"
                                    Background="{TemplateBinding Background}"
                                    BorderBrush="{DynamicResource TabBorderBrush}"
                                    BorderThickness="1"
                                    SnapsToDevicePixels="True">
                                    <ContentPresenter ContentSource="Header"
                                          HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}"
                                          VerticalAlignment="{TemplateBinding VerticalContentAlignment}"
                                          Margin="{TemplateBinding Padding}"/>
                                </Border>
                                <ControlTemplate.Triggers>
                                    <Trigger Property="IsMouseOver" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabHoverBrush}"/>
                                    </Trigger>
                                    <Trigger Property="IsSelected" Value="True">
                                        <Setter TargetName="Bd" Property="Background" Value="{DynamicResource TabSelectedBrush}"/>
                                        <Setter Property="Foreground" Value="{DynamicResource TextBrush}"/>
                                    </Trigger>
                                </ControlTemplate.Triggers>
                            </ControlTemplate>
                        </Setter.Value>
                    </Setter>
                </Style>
            </TabControl.ItemContainerStyle>



            <!-- Tab headers template -->
            <TabControl.ItemTemplate>
                <DataTemplate>
                    <TextBlock Text="{Binding Header}" 
                       FontWeight="Bold" 
                       HorizontalAlignment="Center"
                       VerticalAlignment="Center"/>
                </DataTemplate>
            </TabControl.ItemTemplate>

        <!-- Tab content -->
            <TabControl.ContentTemplate>
                <DataTemplate>
                    <ContentControl Content="{Binding}"/>
                </DataTemplate>
            </TabControl.ContentTemplate>

            <!-- Map ViewModels to Views -->
            <TabControl.Resources>
                <DataTemplate DataType="{x:Type vm:MoviesTabViewModel}">
                    <views:MoviesTabView/>
                </DataTemplate>
                <DataTemplate DataType="{x:Type vm:SeriesTabViewModel}">
                    <views:SeriesTabView/>
                </DataTemplate>
            </TabControl.Resources>
        </TabControl>
    </DockPanel>
</Window>
